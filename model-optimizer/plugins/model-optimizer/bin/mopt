#!/usr/bin/env node
// model-optimizer plugin command: runs the bundled CLI in ../lib (no npm install needed).
// Written so it runs unchanged as CommonJS or as an ES module.
Promise.all([import("node:fs"), import("node:path"), import("node:url")]).then(async ([fs, path, url]) => {
  const here = path.dirname(fs.realpathSync(process.argv[1]));
  const { main } = await import(url.pathToFileURL(path.join(here, "..", "lib", "mopt.mjs")).href);
  process.exitCode = await main(process.argv.slice(2));
});
